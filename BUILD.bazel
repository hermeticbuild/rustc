load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("//rust:distribution.bzl", "rustc_distribution")

package(default_visibility = ["//visibility:public"])

string_flag(
    name = "linkage",
    build_setting_default = "static",
    values = [
        "static",
        "upstream",
    ],
)

config_setting(
    name = "upstream",
    flag_values = {":linkage": "upstream"},
)

config_setting(
    name = "thin_lto",
    values = {"features": "thin_lto"},
)

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        "container-image": "docker://buildpack-deps@sha256:7d9a7601d4e042e3578d7557186c745e03524bd3c751680618639db99d7e9ced",
    },
)

alias(
    name = "rustc",
    actual = "@rustc_sources//src/compiler/rustc:rustc",
)

[rustc_distribution(
    name = variant + "_distribution",
    variant = variant,
) for variant in [
    "upstream",
    "static",
]]

[filegroup(
    name = variant + "_archive",
    srcs = [":" + variant + "_distribution"],
    output_group = "archive",
) for variant in [
    "upstream",
    "static",
]]
