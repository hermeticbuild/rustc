load("@rules_python//python:defs.bzl", "py_binary")
load(":defs.bzl", "compiler_benchmark")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "compare",
    srcs = ["compare.py"],
    data = glob([
        "fixtures/*.rs",
        "proc_macro_fixtures/*.rs",
    ]),
    main = "compare.py",
)

compiler_benchmark(
    name = "results",
    static = "//:static_distribution",
    tags = ["manual"],
    upstream = "//:upstream_distribution",
)

compiler_benchmark(
    name = "proc_macro_results",
    static = "//:static_distribution",
    tags = ["manual"],
    upstream = "//:upstream_distribution",
    workloads = [
        "proc_macro_records/frontend",
        "proc_macro_records/debug",
    ],
)
